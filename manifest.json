{
    "manifest_version": 3,
    "name": "ChatGPT Character Theme",
    "version": "0.1.0",
    "description": "Adds selectable character themes to the ChatGPT conversation UI.",
    "content_scripts": [
        {
            "matches": ["https://chatgpt.com/*"],
            "js": ["src/content.js"],
            "css": ["src/styles.css"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/koharu_normal.png", 
                "assets/koharu_happy.png", 
                "assets/koharu_sad.png", 
                "assets/koharu_panic.png", 
                "assets/koharu_thinking.png", 
                "assets/koharu_surprised.png", 
                "assets/hiyori_normal.png",
                "assets/hiyori_happy.png",
                "assets/hiyori_sad.png",
                "assets/hiyori_panic.png",
                "assets/hiyori_thinking.png",
                "assets/hiyori_surprised.png"
            ],
            "matches": ["https://chatgpt.com/*"]
        }
    ],
    "permissions": [
        "storage"
    ]
}